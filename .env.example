# ScopeGuard Environment Configuration
# Copy to .env and fill in values: cp .env.example .env

# ── LocalStack ──────────────────────────────────────────
# Get a free token at https://localstack.cloud
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_ENDPOINT=http://localhost:4566
LOCALSTACK_DEBUG=0

# ── ScopeGuard Proxy ───────────────────────────────────
# Proxy mode: full | tagging_only | passthrough
SCOPEGUARD_MODE=full

# Database path for audit logs
SCOPEGUARD_DB_PATH=data/scopeguard_audit.db

# Fail-closed on internal errors (recommended: true)
SCOPEGUARD_FAIL_CLOSED=true

# Log level: DEBUG | INFO | WARNING | ERROR
SCOPEGUARD_LOG_LEVEL=INFO

# ── AWS Credentials (for LocalStack — use dummy values) ─
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ── Optional: Anthropic API (for real agent integration) ─
# ANTHROPIC_API_KEY=
